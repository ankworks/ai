{
  "name": "conai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ConAI — free-first AI All-in-One SaaS workspace (Cloudflare Workers)",
  "license": "BSD-3-Clause",
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present --parallel",
    "dev:web": "npm run dev --workspace @conai/web",
    "dev:workspace": "npm run dev --workspace @conai/workspace",
    "dev:account": "npm run dev --workspace @conai/account",
    "dev:admin": "npm run dev --workspace @conai/admin",
    "dev:status": "npm run dev --workspace @conai/status",
    "dev:api": "npm run dev --workspace @conai/api",
    "build": "npm run build --workspaces --if-present",
    "deploy": "npm run deploy --workspace @conai/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:local": "npm run db:migrate:local --workspace @conai/api"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.19.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
