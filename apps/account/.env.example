# Public build-time configuration for apps/account (no secrets).
# Copy to .env and adjust.

VITE_API_BASE_URL=/api
VITE_BASE_PATH=/

VITE_WEB_URL=http://localhost:5173
VITE_WORKSPACE_URL=http://localhost:5174
VITE_ACCOUNT_URL=http://localhost:5175
VITE_ADMIN_URL=http://localhost:5176
VITE_STATUS_URL=http://localhost:5177

VITE_CONAI_MODE=path

# Cloudflare Turnstile SITE key (public by design) — renders the captcha widget
# on sign-in/sign-up when set. The SECRET stays server-side (TURNSTILE_SECRET_KEY).
VITE_TURNSTILE_SITE_KEY=
