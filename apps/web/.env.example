# Public build-time configuration for apps/web (no secrets — VITE_* only).
# Copy to .env and adjust.

# API origin: "/api" (path mode → Vite proxies to wrangler dev) or "https://api.conai.dpdns.org"
VITE_API_BASE_URL=/api

# Base path of this app (subdomain mode: "/")
VITE_BASE_PATH=/

# Cross-app links.
# Local dev (separate Vite servers): point at the other apps' dev ports.
# Path-mode production: relative paths (/app, /account, …).
# Subdomain-mode production: https://app.conai.dpdns.org, etc.
VITE_WEB_URL=/
VITE_WORKSPACE_URL=http://localhost:5174
VITE_ACCOUNT_URL=http://localhost:5175
VITE_ADMIN_URL=http://localhost:5176
VITE_STATUS_URL=http://localhost:5177

# Routing mode marker: "subdomain" | "path"
VITE_CONAI_MODE=path
