# ConAI API — local secrets (copy to .dev.vars, which is git-ignored).
# NEVER commit real values. Remote deploys use `wrangler secret put <NAME>`.

# Phase 2 — sessions/CSRF signing (generate ≥32 random bytes: `openssl rand -hex 32`)
SESSION_SECRET=

# Phase 3 — AI provider (platform Owner-managed; never sent to browsers)
OLLAMA_API_KEY=

# Phase 2 — Cloudflare Turnstile server-side verification
TURNSTILE_SECRET_KEY=

# Phase 4 — Backblaze B2 (S3-compatible) application key
B2_APP_KEY_ID=
B2_APP_KEY=
B2_BUCKET_REGION=

# Phase 2 — OAuth provider secrets (never exposed to the frontend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Phase 7 — Search gateway provider key
SEARCH_API_KEY=
SEARCH_PROVIDER=

# Phase 7 — Web Push VAPID (generate: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
