// ConAI API Worker configuration.
// Local dev:  npm run dev:api   (wrangler dev → http://localhost:8787)
// Secrets:    apps/api/.dev.vars (local) / `wrangler secret put …` (remote) — never committed.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Must match the Worker name in the Cloudflare dashboard / Workers Build
  // connected build ("ai"). A mismatch makes CI override the name and warn.
  "name": "ai",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // nodejs_compat is REQUIRED by better-auth (AsyncLocalStorage via node:async_hooks and
  // the scrypt password path via node:crypto). Declared explicitly — never assumed.
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ROUTING_MODE": "path",
    "ENVIRONMENT": "development",
    "APP_VERSION": "0.1.0",
    "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "conai",
      // Replace with the real id from `wrangler d1 create conai` before remote deploys.
      "database_id": "6b83445a-d943-4322-b7cb-4365812f2171",
      "migrations_dir": "../../packages/database/migrations",
    },
  ],
  "kv_namespaces": [
    {
      "binding": "CACHE",
      // Replace with the real id from `wrangler kv namespace create CACHE` before remote deploys.
      "id": "72a324f6e93b45e7af163cccc46121eb",
    },
  ],
  "observability": { "enabled": true },
  "dev": { "port": 8787 },
  // Path mode: the single Worker serves the five assembled SPAs
  // (scripts/assemble-assets.mjs). `run_worker_first` + `binding` give Hono
  // full control — /api/* stays JSON, unknown app paths fall back to that
  // SPA's index.html for client-side routing (see src/app.ts).
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none",
  },
}
